# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Painel Supabase → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# (Opcional) Recursos de IA — assistente virtual (chatbot) e organização da
# anotação clínica. Crie a chave em https://aistudio.google.com/apikey
# Sem ela, o app funciona normalmente; apenas a IA fica indisponível.
GEMINI_API_KEY=sua-chave-gemini-aqui
